{
  "version": 1,
  "steps": [
    {"id": "orders", "op": "scan", "table": "orders"},
    {"id": "this_year", "op": "filter", "input": "orders",
     "predicate": {"kind": "binary", "op": ">=", "left": {"kind": "column", "name": "order_date"},
                   "right": {"kind": "literal", "value": "2026-01-01", "type": "date"}}},
    {"id": "spend", "op": "aggregate", "input": "this_year", "group_by": ["customer_id"],
     "aggregates": [{"func": "sum", "arg": {"kind": "column", "name": "amount"}, "output": "total_spend"}]},
    {"id": "reviews", "op": "scan", "table": "reviews"},
    {"id": "history", "op": "fetch", "input": "spend", "source": "reviews",
     "on": {"left": "customer_id", "right": "customer_id"}, "fields": ["created_at", "text"],
     "order_by": [{"expr": {"kind": "column", "name": "created_at"}}], "limit": 30, "output": "review_history"},
    {"id": "scored", "op": "semantic_score", "input": "history", "context": ["review_history"],
     "question": "Across this customer's reviews in chronological order, how increasingly dissatisfied do they appear with our pricing?",
     "levels": ["No pricing complaints, or satisfaction with pricing is stable",
                "Occasional pricing complaints with no clear worsening",
                "Pricing complaints that grow more frequent or more severe over time"],
     "output": "pricing_dissatisfaction"},
    {"id": "top", "op": "top_k", "input": "scored", "k": 100,
     "keys": [{"expr": {"kind": "column", "name": "total_spend"}, "descending": true},
              {"expr": {"kind": "column", "name": "customer_id"}}]},
    {"id": "result", "op": "project", "input": "top", "exprs": [
      {"name": "customer_id", "expr": {"kind": "column", "name": "customer_id"}},
      {"name": "total_spend", "expr": {"kind": "column", "name": "total_spend"}},
      {"name": "pricing_dissatisfaction", "expr": {"kind": "column", "name": "pricing_dissatisfaction"}}]}
  ]
}
